campaign parameter-sets
backend local

@list checks inputs calibration

@table pairs ped run:
    296 298
    296 300
    303 304

check-{check}:
    @each check in checks
    echo checking {check}

prepare: check-{check}
    echo preparing

convert-{run}: prepare
    @each run in pairs.ped pairs.run
    echo converting {run}

pedestal-{ped}: convert-{ped}
    @each ped in pairs.ped
    echo fitting pedestal {ped}

calibrate-{ped}-{run}: pedestal-{ped} convert-{run}
    @each ped run in pairs
    echo calibrating {run} with pedestal {ped}

analyze-{ped}-{run}: calibrate-{ped}-{run}
    echo analyzing {run} with pedestal {ped}

finish: analyze-{ped}-{run}
    echo all pairs finished
